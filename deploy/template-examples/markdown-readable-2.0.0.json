{
  "schema_version": 2,
  "id": "markdown-readable",
  "version": "2.0.0",
  "name": "大字疏排",
  "description": "固定合成内容预览；基础Markdown，不推断题目归属",
  "content_types": [
    "markdown-basic"
  ],
  "parameters": {
    "font_family": "Droid Sans Fallback",
    "body_pt": 14,
    "line_spacing": 1.5,
    "space_after_pt": 10,
    "margin_cm": 2.8,
    "width_cm": 21,
    "height_cm": 29.7,
    "title_pt": 16,
    "part_pt": 14,
    "chapter_pt": 13,
    "subject_pt": 13,
    "type_pt": 11.5,
    "source_pt": 9,
    "footer_pt": 9,
    "heading_before_pt": 3,
    "option_indent_cm": 0.65,
    "option_hanging_cm": 0.35,
    "short_question_max_fraction": 0.3,
    "short_option_max_lines": 3,
    "short_stem_max_lines": 3,
    "minimum_start_lines": 2,
    "footer_distance_cm": 1,
    "max_pages": 50,
    "show_source_labels": false,
    "space_before_pt": 0,
    "page_numbers": true
  }
}