# Local, disposable integration fixture. Never use this root test image in production.
ARG FILETOOLS_TEST_IMAGE=nas-filetools-test:1.2.1
FROM ${FILETOOLS_TEST_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends samba smbclient acl systemd util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -M chen && useradd -u 24002 -M liang && useradd -u 24003 -M azl
ENTRYPOINT ["/opt/nas-filetools/.venv/bin/python"]
