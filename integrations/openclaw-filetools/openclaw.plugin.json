{
  "id": "nas-filetools",
  "name": "NAS FileTools",
  "description": "Temporary file evidence tools",
  "version": "1.2.0",
  "configSchema": {
    "type": "object",
    "required": [
      "bindings"
    ],
    "properties": {
      "bindings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "agent_id",
            "sender_id",
            "channel_id",
            "account_id"
          ],
          "properties": {
            "user_id": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "sender_id": {
              "type": "string",
              "minLength": 1
            },
            "channel_id": {
              "type": "string",
              "minLength": 1
            },
            "account_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 16
      },
      "management": {
        "type": "object",
        "required": [
          "python",
          "entry",
          "config"
        ],
        "properties": {
          "python": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "config": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "workspaces": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "workspace"
            ],
            "properties": {
              "workspace": {
                "type": "string"
              },
              "source_roots": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "object",
                    "required": [
                      "path",
                      "kind"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "kind": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "workspace"
                          },
                          {
                            "type": "string",
                            "const": "nas"
                          },
                          {
                            "type": "string",
                            "const": "media"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "filetools_register",
      "filetools_inspect",
      "filetools_extract",
      "filetools_status",
      "filetools_cancel",
      "filetools_read",
      "filetools_find",
      "filetools_files",
      "filetools_python",
      "filetools_save_minutes"
    ]
  }
}
